# Copy to .env (git-ignored) and edit. Every value is optional: these are the defaults.

GETONBOARD_API_URL=https://www.getonbrd.com/api/v0
# seconds to wait between API requests (rate limit)
REQUEST_DELAY_S=1.0
# apply_today.py: lowest score_jd (0-6) worth showing
MIN_SCORE=4
# Get on Board seniority ids kept by the radar: 1=Sin experiencia, 2=Junior,
# 3=Semi Senior (3-5 years in LATAM, not entry-level), 4=Senior, 5=Expert
SENIORITY_IDS=1,2
# comma-separated, matched as whole words against the job title;
# a keyword must start and end with a letter or digit ("c++" would never match)
PROFILE_KEYWORDS=data,datos,ai,ia,ml,python,etl,analytics,machine learning,inteligencia artificial,rag,llm
BLACKLIST_KEYWORDS=sales,docente,soporte,support
# no seniority and no level keyword: keep the posting if it names this stack
STACK_KEYWORDS=python,fastapi,llm,rag,sql,postgresql
# generic titles accepted as data_ai only when requisitos mention AI context
BROAD_TITLE_KEYWORDS=software engineer,backend engineer,python developer
AI_CONTEXT_KEYWORDS=llm,rag,data pipeline,data pipelines,ai
# lowest score_jd for ai_training leads (data_ai uses MIN_SCORE)
AI_TRAINING_MIN_SCORE=2
# titles of the AI training/evaluation vertical (vertical=ai_training)
# these titles skip the seniority filter: the platforms don't label levels
AI_TRAINING_KEYWORDS=evaluator,evaluación,ai trainer,coding trainer,software engineering ai trainer,quality evaluator,agent evaluator,audio evaluator,prompt evaluator,code evaluator,ai rater,rlhf,annotation,swe-bench,coding specialist

# tailoring_engine.py (GROQ_API_KEY is required, the rest are defaults)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
